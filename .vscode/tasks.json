{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build 2048 Project",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "${workspaceFolder}/2048/*.cpp",
                "-o",
                "${workspaceFolder}/2048-game",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
